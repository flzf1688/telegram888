[Unit]
Description=Telegram888 development application
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
[Service]
User=telegram888
Group=telegram888
WorkingDirectory=/opt/telegram888
EnvironmentFile=/etc/telegram888/app.env
ExecStart=/opt/telegram888/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/telegram888
UMask=0077
[Install]
WantedBy=multi-user.target
